{
  "name": "brewlite-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BrewLite - Coffee & Tea Mobile-First Ordering System (Assignment 2)",
  "workspaces": [
    "apps/web",
    "apps/api",
    "tests"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace=apps/api run start:dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "lint": "npm --workspace=apps/api run lint && npm --workspace=apps/web run lint",
    "test": "npm --workspace=apps/api run test && npm --workspace=apps/web run test",
    "test:integration": "npm --workspace=apps/api run test:integration",
    "test:e2e": "npm --workspace=tests run test:e2e",
    "db:migrate": "npm --workspace=apps/api run typeorm:migration:run",
    "db:seed": "npm --workspace=apps/api run seed",
    "db:reset": "npm --workspace=apps/api run db:reset",
    "smoke:test": "node apps/api/scripts/smoke-test.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
