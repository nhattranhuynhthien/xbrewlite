# ========================================================
# BrewLite - Global Environment Variables Template
# Managed by: TV1 (Tech Lead / DevOps)
# NOTE: Do NOT put real secrets in this template or commit .env files
# ========================================================

# General Configuration
NODE_ENV=development
PORT=3001
WEB_PORT=3000

# NestJS API Backend (apps/api)
API_HOST=localhost
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=brewlite_user
DB_PASSWORD=brewlite_secure_password
DB_NAME=brewlite_db
DATABASE_URL=postgresql://brewlite_user:brewlite_secure_password@localhost:5432/brewlite_db

# Test Database Configuration (Used in CI & Integration Tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=brewlite_test_user
TEST_DB_PASSWORD=brewlite_test_password
TEST_DB_NAME=brewlite_test_db
TEST_DATABASE_URL=postgresql://brewlite_test_user:brewlite_test_password@localhost:5433/brewlite_test_db

# JWT & Security (TV2 - Auth)
JWT_SECRET=brewlite_super_secret_jwt_key_sample_change_in_production
JWT_EXPIRES_IN=86400s

# Next.js Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME=BrewLite Coffee & Tea
NEXT_PUBLIC_APP_ENV=development

# Payment Simulation Config (TV4 - Payment)
PAYMENT_MOCK_TIMEOUT_MS=600
PAYMENT_WEBHOOK_SECRET=sample_payment_webhook_secret_for_dev

# Production Example URLs (Referenced in Deployment - TV1/TV2)
PRODUCTION_API_URL=https://api.brewlite.example.com
PRODUCTION_WEB_URL=https://app.brewlite.example.com
